# Copy to `.env.local` to override. All variables are optional.

# Base URL of the Rick and Morty API (e.g. a proxy or a local mock server).
# VITE_RICK_AND_MORTY_API_URL=https://rickandmortyapi.com/api

# Base URL of PokéAPI (REST v2).
# VITE_POKEAPI_URL=https://pokeapi.co/api/v2

# Base URL of the Pokémon sprite repository (pixel sprites and official artwork).
# VITE_POKEMON_SPRITES_URL=https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon

# Base URL of a SWAPI mirror whose collection endpoints return every item at once
# (e.g. GET /people → array of all people).
# VITE_SWAPI_URL=https://swapi.info/api

# Base URL of PotterDB (JSON:API).
# VITE_POTTERDB_URL=https://api.potterdb.com/v1
